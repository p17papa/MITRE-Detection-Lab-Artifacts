<!-- Custom Ruleset for Wazuh -->
<!-- possible path:/var/ossec/etc/rules/local_rules.xml  -->

<group name="local">

  <!-- whoami via auditd -->
  <rule id="100011" level="6">
    <if_sid>80700</if_sid>
    <field name="audit.command">whoami</field>
    <description>[T1033] whoami execution detected via auditd</description>
    <group>attack,discovery,linux,auditd</group>
  </rule>


  <!-- ==== Discovery: Network config (ifconfig/ip) ==== -->
  <rule id="100100" level="6">
    <if_group>auditd</if_group>
    <field name="audit.command">ifconfig</field>
    <description>[T1016] Network Configuration Discovery (ifconfig) via auditd</description>
    <group>localattack,discovery,linux,auditd</group>
  </rule>

  <rule id="100101" level="6">
    <if_group>auditd</if_group>
    <field name="audit.command">ip</field>
    <description>[T1016] Network Configuration Discovery (ip) via auditd</description>
    <group>localattack,discovery,linux,auditd</group>
  </rule>

  <!-- ==== Collection/Discovery: find ==== -->
  <rule id="100102" level="6">
    <if_group>auditd</if_group>
    <field name="audit.command">find</field>
    <description>[T1083] File and Directory Discovery (find) via auditd</description>
    <group>localattack,discovery,linux,auditd</group>
  </rule>

  <!-- ==== Command & Control / Exfil: curl / wget ==== -->
  <rule id="100103" level="6">
    <if_sid>80700</if_sid> <!-- ή <if_group>auditd</if_group> -->
    <field name="audit.command" type="pcre2">^(curl|wget)$</field>
    <description>[T1105] Potential Remote File Transfer / Download (curl/wget) via auditd</description>
    <group>localattack,command-and-control,exfiltration,linux,auditd</group>
  </rule>


  <!-- ==== Discovery (Remote system): ping ==== -->
  <rule id="100104" level="5">
    <if_group>auditd</if_group>
    <field name="audit.command">ping</field>
    <description>[T1018] Remote System Discovery (ping) via auditd</description>
    <group>localattack,discovery,linux,auditd</group>
  </rule>

  <!-- ==== Persistence/Execution: crontab ==== -->
  <rule id="100105" level="7">
    <if_group>auditd</if_group>
    <field name="audit.command">crontab</field>
    <description>[T1053.003] Cron job scheduling detected (crontab) via auditd</description>
    <group>localattack,persistence,execution,linux,auditd</group>
  </rule>

  <!-- ==== Discovery: hostname ==== -->
  <rule id="100106" level="6">
    <if_sid>80700</if_sid>
    <field name="audit.command">hostname</field>
    <description>[T1082] Hostname discovery via auditd</description>
    <group>localattack,discovery,linux,auditd</group>
  </rule>

  <!-- ==== Discovery: OS info (lsb_release) ==== -->
  <rule id="100107" level="6">
    <if_sid>80700</if_sid>
    <field name="audit.command">lsb_release</field>
    <description>[T1082] OS information discovery (lsb_release) via auditd</description>
    <group>localattack,discovery,linux,auditd</group>
  </rule>


  <!-- =========================================
       WINDOWS: DISCOVERY / EXECUTION / C2 / IMPACT
       ========================================= -->


